{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "noImplicitAny": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "outDir": "dist-vectors",
        "rootDir": ".",
        "types": ["node", "jest"]
    },
    "include": [
        "src/**/*.ts",
        "test/vectors/**/*.ts"
    ],
    "exclude": [
        "test/vectors/**/*Spec.ts"
    ]
}
